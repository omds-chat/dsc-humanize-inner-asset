{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omds-chat.github.io/dsc-humanize-asset-template/schemas/content/persona.schema.json",
  "title": "dsc-humanize-asset-persona",
  "description": "人物设定内容项,对应包内 persona/ 目录下的单个 JSON 文件。字段与判定口径见 specs/asset-package-spec.md 7.1。",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/contentId",
      "description": "人设标识,包内唯一"
    },
    "name": {
      "$ref": "#/$defs/text",
      "description": "展示名"
    },
    "prefix": {
      "$ref": "#/$defs/text",
      "description": "拼在系统提示词前的固定文本"
    },
    "description": {
      "$ref": "#/$defs/text",
      "description": "语义说明"
    }
  },
  "required": [
    "id",
    "name",
    "prefix"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "内容标识:小写字母开头,只允许小写字母、数字与连字符,长度 2 到 64;同一类型内唯一"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "三段数字,不允许前导零"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "非空文本"
    }
  }
}
