{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omds-chat.github.io/dsc-humanize-asset-template/schemas/content/strategies.schema.json",
  "title": "dsc-humanize-asset-strategies",
  "description": "策略规则内容项,对应包内 strategies/ 目录下的单个 JSON 文件。字段与判定口径见 specs/asset-package-spec.md 7.3。",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/contentId",
      "description": "策略表标识,包内唯一"
    },
    "version": {
      "$ref": "#/$defs/semver",
      "description": "策略表版本,进入解析结果便于追溯"
    },
    "base": {
      "$ref": "#/$defs/strategy",
      "description": "兜底策略,先于所有规则合并"
    },
    "rules": {
      "type": "array",
      "description": "标签到策略的映射;空数组表示只有兜底策略",
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "required": [
    "id",
    "version",
    "rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "内容标识:小写字母开头,只允许小写字母、数字与连字符,长度 2 到 64;同一类型内唯一"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "三段数字,不允许前导零"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "非空文本"
    },
    "strategy": {
      "type": "object",
      "description": "策略对象,字段与模型请求参数同名;每个字段可省略,省略表示不改这一项",
      "properties": {
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "取值 0 到 2"
        },
        "topP": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "取值 0 到 1"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32768,
          "description": "取值 1 到 32768 的整数"
        },
        "stop": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "停止词,去重且不得为空串",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "injection": {
          "$ref": "#/$defs/text",
          "description": "注入到系统提示词的文本"
        }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "description": "一条标签到策略的映射",
      "properties": {
        "label": {
          "$ref": "#/$defs/contentId",
          "description": "标签标识,须能在本次装配所用的标签集中找到"
        },
        "priority": {
          "type": "integer",
          "description": "合并顺序,越大越晚合并,缺省 0"
        },
        "minConfidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "该规则生效的置信度下限,缺省 0"
        },
        "strategy": {
          "$ref": "#/$defs/strategy",
          "description": "命中后要合并的字段,至少给出一个"
        }
      },
      "required": [
        "label",
        "strategy"
      ],
      "additionalProperties": false
    }
  }
}
