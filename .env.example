# 本地联调地址:cp .env.example .env 后生效,这份 .env 不进 git,也不参与构建
# DS_CHAT_PAGES_LINK 是 dsce 本体的页面地址,同时决定它的 dev 服务器主机与端口;
# 本合集的联调必须跑在 dsce 的联调网络里(至少 dsce 本体),所以这里一并列出
DS_CHAT_PAGES_LINK=http://127.0.0.1:61117
# 下面两项是 dsce 读取的插件合集地址,用于在同一网络里核对插件侧行为
DSC_INNER_PLUGIN_PAGES_LINK=http://127.0.0.1:61118
AWESOME_DSC_PLUGIN_PAGES_LINK=http://127.0.0.1:61119
# 本合集自身的本地静态服务地址:把 dist/ 起在这个端口上
DSC_HUMANIZE_INNER_ASSET_PAGES_LINK=http://127.0.0.1:61120

# 本地 npm registry 模拟器(组织仓库 tools/dev-local-npmjs,端口 61116;只有 awesome 与 inner 的收录校验读取)
# 真实环境变量优先于 .env:命令行 --registry 优先级最高,其次是环境变量 NPM_REGISTRY_URL
NPM_REGISTRY_URL=http://127.0.0.1:61116/
